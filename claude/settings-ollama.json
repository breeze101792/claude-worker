{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash:cloud",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-pro:cloud",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "minimax-m3:cloud"
  },
  "sandbox": {
      "enabled": true,
      "filesystem": {
          "allowWrite": ["~/.npm-global", "/tmp/claude"]
      }
  },
  "permissions": {
    "allow": [
        "WebFetch",
        "Bash(npm run lint)",
        "Bash(npm run test *)"
    ],
    "deny": [
        "Read(./.env)",
        "Read(./.env.*)",
        "Read(./secrets/**)",
        "Bash(rm -rf *)",
        "Bash(git push --force *)"
    ]
  },
  "attribution": {
      "coAuthoredBy": false,
      "commit": "",
      "pr": ""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "terminalTitleFromRename": false

}
